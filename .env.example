# Supabase project credentials.
# Get these from your Supabase project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key, used for privileged operations (e.g. admin actions).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to sign staff PIN-login session cookies.
# Generate one with: openssl rand -base64 32
STAFF_SESSION_SECRET=

# Public base URL, used to build QR code target links.
# Set this to your deployed app origin (e.g. https://baser-gilt.vercel.app).
# Falls back to http://localhost:3000 in local dev when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
